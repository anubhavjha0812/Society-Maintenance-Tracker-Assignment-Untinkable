# Copy to .env and fill in real values. See README.md "Setup" for where to
# get each of these from their respective free-tier dashboards.

NODE_ENV=development
PORT=4000

# Neon (https://neon.tech) — Postgres connection string, pooled endpoint
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/society_tracker?sslmode=require"

# Better-Auth
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"
BETTER_AUTH_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# Upstash Redis (https://upstash.com) — use the TCP "rediss://" endpoint,
# not the REST URL, because BullMQ needs a real Redis protocol connection.
UPSTASH_REDIS_URL="rediss://default:password@example.upstash.io:6379"

# Cloudflare R2 (https://dash.cloudflare.com -> R2)
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="society-tracker-media"
R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"

# Resend (https://resend.com)
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="notices@yourdomain.com"
