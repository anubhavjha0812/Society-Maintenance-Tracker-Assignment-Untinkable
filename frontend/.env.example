# Copy to .env.local and fill in real values.

# Backend API base (no trailing slash) — e.g. http://localhost:4000 in dev,
# your Render service URL in production.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Same R2 public base URL as backend/.env's R2_PUBLIC_BASE_URL — used to
# render uploaded complaint photos directly from R2.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub-xxxxxxxx.r2.dev"
